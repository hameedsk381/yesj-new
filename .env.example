# Site Configuration
NEXT_PUBLIC_SITE_URL=https://yesj.org
NEXT_PUBLIC_SITE_NAME=YESJ

# Social Media Links
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/yesj.official
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/yesj.official

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=info@yesj.org
NEXT_PUBLIC_CONTACT_PHONE=+91XXXXXXXXXX

# Google Services
NEXT_PUBLIC_GOOGLE_VERIFICATION_CODE=your-google-verification-code
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@host:port/database

# PostgreSQL credentials (for docker-compose)
POSTGRES_USER=yesj
POSTGRES_PASSWORD=yesj_password
POSTGRES_DB=yesj

# MinIO Object Storage
MINIO_ENDPOINT=minio.yesj.org
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET_NAME=yesj-uploads
MINIO_REGION=us-east-1

# Google Cloud Storage (used for file uploads — images, PDFs, NOCs)
# GCS_PROJECT_ID and the service-account credentials are required for uploads.
# Without them, storage functions log a warning and return early (uploads fail).
# Generate a service-account key at https://console.cloud.google.com/iam-admin/serviceaccounts
GCS_PROJECT_ID=your-gcp-project-id
GCS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Replace newlines with \n when pasting the private key (the app handles both).
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GCS_BUCKET_NAME=yesj

# Email Service (Resend, SendGrid, etc.)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXX
EMAIL_FROM=YESJ <noreply@yesj.org>

# Strapi CMS
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your_strapi_api_token_here

# Payment Gateway (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# JWT Secret for authentication. Must be 32+ chars; the app refuses to boot otherwise.
# Generate with: openssl rand -hex 48
JWT_SECRET=<set-to-a-32+-char-random-string>

# Admin bootstrap (only used by seeding scripts — never as runtime fallback)
ADMIN_USERNAME=<set-me>
ADMIN_PASSWORD=<set-me>
ADMIN_TOKEN=<set-me>
