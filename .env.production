# =================================================================
# YESJ PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env and fill in the actual production values.
# DO NOT COMMIT THE ACTUAL .ENV FILE!

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://yesj.in
NEXT_PUBLIC_SITE_NAME=YESJ
NODE_ENV=production

# Social Media Links
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/yesj_india
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/yesj_india

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=info@yesj.in
NEXT_PUBLIC_CONTACT_PHONE=+91XXXXXXXXXX

# AI Keys (Required for RAG functionality)
GROQ_API_KEY=your_production_groq_api_key
OPENAI_API_KEY=your_production_openai_api_key

# MinIO Object Storage (Optional, defaults used in docker-compose)
MINIO_ENDPOINT=minio.yourdomain.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET_NAME=yesj-uploads

# Email Service (Resend)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXX
EMAIL_FROM=YESJ <noreply@yesj.in>

# Payment Gateway (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Security (CHANGE THESE!)
JWT_SECRET=generate-a-long-random-string-for-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_TOKEN=generate-a-secure-admin-token
